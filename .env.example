# ============================================================
# BOLA Strike Enterprise v12.0 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# CRITICAL: Change ALL default values before deploying to production!

# --- API Security ---
BOLA_API_KEY=change-me-to-a-strong-random-key
IDP_CLIENT_SECRET=change-me-to-a-strong-random-secret

# --- CISO Telemetry (Zero-Trust JWT) ---
CISO_JWT_SECRET=change-me-to-a-strong-jwt-secret

# --- IdP Matrix Fuzzer ---
IDP_MATRIX_SECRET=change-me-to-a-fuzzer-signing-key

# --- FAIR Risk Appetite (CI/CD Pipeline Gate) ---
BOLA_RISK_APPETITE_CAD=50000.0

# --- SSL Verification (set to "true" in production) ---
BOLA_SSL_VERIFY=false

# --- Infrastructure ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Grafana ---
GRAFANA_PASSWORD=change-me

# --- Logging ---
LOG_LEVEL=INFO

# --- OAuth2 Token Secrets (per role) ---
# ATTACKER_CLIENT_SECRET=...
# VICTIM_CLIENT_SECRET=...

# --- Threat Intelligence ---
# OTX_API_KEY=your-alienvault-otx-key

# --- Allowed Spec Directory (LFI Protection) ---
# BOLA_SPEC_BASE_DIR=/app/specs
