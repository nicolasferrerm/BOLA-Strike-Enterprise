# ============================================================
# BOLA Strike Enterprise v7.0 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- API Security ---
BOLA_API_KEY=change-me-to-a-strong-random-key
IDP_CLIENT_SECRET=change-me-to-a-strong-random-secret

# --- Infrastructure ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- CORS (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Grafana ---
GRAFANA_PASSWORD=change-me

# --- OAuth2 Token Secrets (per role) ---
# ATTACKER_CLIENT_SECRET=...
# VICTIM_CLIENT_SECRET=...

# --- Threat Intelligence ---
# OTX_API_KEY=your-alienvault-otx-key

# --- Allowed Spec Directory (LFI Protection) ---
# BOLA_SPEC_BASE_DIR=/app/specs
