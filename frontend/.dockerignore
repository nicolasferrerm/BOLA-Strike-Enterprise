# =============================================================================
# BOLA Strike Enterprise — Frontend .dockerignore
# Optimized build context for the React/TypeScript frontend container.
# =============================================================================

# --- Node.js Dependencies (rebuilt inside container) ---
node_modules

# --- Build Output (rebuilt inside container) ---
dist
build

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Documentation ---
*.md

# --- Version Control ---
.git
.gitignore
.gitattributes

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Testing ---
coverage/
.nyc_output/

# --- Misc ---
*.log
*.bak
*.tmp
