# ============================================================
# BOLA Strike Enterprise - .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Environment Variables / Secrets ---
.env
.env.local
.env.*.local

# --- Node.js / Frontend ---
frontend/node_modules/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE / Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Docker ---
*.log

# --- Reports / Artifacts (generated at runtime) ---
reports/
evidence_locker/
*.sarif
*.cef

# --- OS ---
*.tmp
*.bak
*.orig

# --- Pytest / Coverage ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml
